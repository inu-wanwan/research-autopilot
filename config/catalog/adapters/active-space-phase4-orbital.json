{
  "name": "active-space-phase4-orbital",
  "version": "1.0.0",
  "description": "Phase 4 orbital-level exhaustive CASCI conditions of active_space_research. One artifact per (molecule, geometry_id, k) result JSON, cross-checked against the orbital CASCI base cache of the same commit. Field meanings follow src/active_space_selection/experiments/phase4_orbital.py and data/cache.py of that repository; tolerance 1e-9 Ha follows its numerical_tolerance (configs/phase4_orbital_main.yaml).",
  "artifacts": [
    {
      "rule": "phase4-orbital-exhaustive-condition",
      "kind": "orbital-casci-exhaustive-condition",
      "pattern": "outputs/phase4_orbital_diagnostics/supervisor_{run_commit}/{job}/results/exhaustive/{geometry_id}/orbital_greedy_optimality_k{file_k}.json",
      "captures": {"run_commit": "[0-9a-f]{7}", "job": "[a-z0-9]+_exhaustive", "file_k": "[0-9]+"},
      "fields": {
        "molecule": "/molecule",
        "geometry_molecule": "/geometry/molecule",
        "doc_geometry_id": "/geometry/geometry_id",
        "result_geometry_id": "/result/geometry_id",
        "k": "/nominal_budget_k",
        "result_k": "/result/nominal_budget_k",
        "diagnostic_type": "/diagnostic_type",
        "experiment_identifier": "/experiment_identifier",
        "git_commit": "/reproducibility/git_commit",
        "git_commit7": {"pointer": "/reproducibility/git_commit", "prefix": 7},
        "working_tree_status": "/reproducibility/working_tree_status",
        "pyscf_version": "/reproducibility/pyscf_version",
        "science_config_hash": "/science_config_hash",
        "calculation_config_hash": "/calculation_config_hash",
        "basis": "/basis",
        "legacy_cache_reuse": "/legacy_cache_reuse/enabled",
        "candidate_mo_indices": {"pointer": "/candidate_orbitals", "item": "/mo_index"},
        "full_evaluations": "/result/full_evaluations",
        "evaluated_count": {"pointer": "/result/full_evaluations", "transform": "length"},
        "enumerated_full_count": "/result/enumerated_full_count",
        "optimum_energy": "/result/full_optimum/total_energy",
        "optimum_orbitals": "/result/full_optimum/active_orbitals"
      },
      "identity": ["molecule", "geometry_id", "k"],
      "provenance": ["git_commit", "run_commit", "job", "science_config_hash", "calculation_config_hash",
                     "experiment_identifier", "working_tree_status", "pyscf_version"],
      "metadata": ["basis", "enumerated_full_count", "optimum_energy", "optimum_orbitals", "candidate_mo_indices"],
      "checks": [
        {"type": "equals", "field": "diagnostic_type", "value": "orbital_greedy_optimality"},
        {"type": "equals", "field": "experiment_identifier", "value": "phase4-orbital-v1"},
        {"type": "equals_field", "field": "geometry_molecule", "other": "molecule"},
        {"type": "equals_field", "field": "doc_geometry_id", "other": "geometry_id"},
        {"type": "equals_field", "field": "result_geometry_id", "other": "geometry_id"},
        {"type": "equals_field", "field": "result_k", "other": "k"},
        {"type": "equals_field", "field": "file_k", "other": "k"},
        {"type": "equals_field", "field": "git_commit7", "other": "run_commit"},
        {"type": "one_of", "field": "working_tree_status", "value": ["clean", "clean_platform_line_endings_ignored"]},
        {"type": "equals", "field": "legacy_cache_reuse", "value": false},
        {"type": "equals_field", "field": "evaluated_count", "other": "enumerated_full_count"},
        {"type": "finite", "field": "optimum_energy"},
        {"type": "items_finite", "field": "full_evaluations", "item": "/total_energy"},
        {"type": "items_equal", "field": "full_evaluations", "item": "/solver_metadata/converged", "value": true},
        {"type": "items_subset", "field": "full_evaluations", "item": "/active_orbitals", "other": "candidate_mo_indices"},
        {"type": "items_min_equals", "field": "full_evaluations", "item": "/total_energy", "other": "optimum_energy",
         "tolerance": 1e-9},
        {"type": "cross_reference", "field": "full_evaluations", "item": "/active_orbitals", "item_value": "/total_energy",
         "target_pattern": "outputs/phase4_orbital_diagnostics/main_{git_commit7}/cache/{molecule}/{geometry_id}/*.json",
         "target_key": "/key/active_orbitals", "target_value": "/total_energy",
         "target_match": {"/key/config_hash": "calculation_config_hash", "/metadata/geometry_id": "geometry_id"},
         "target_equals": {"/format_version": "active-space-selection-orbital-casci-cache-v1",
                           "/metadata/orbital_schema_version": "active-space-selection-orbital-v1",
                           "/metadata/solver": "pyscf-casci-sector-sweep-singlet-adaptive-davidson-v2"},
         "tolerance": 1e-9}
      ]
    }
  ]
}
