# Copy to .env (git-ignored) and replace every value. chmod 600 .env
# Never commit .env or paste real values into issues, logs or notifications.

# --- PostgreSQL (compose-internal only) ---
POSTGRES_USER=prefect
# URL-safe characters only (it is embedded in the DB URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=prefect

# --- Prefect Basic Auth (defense in depth on top of Tailscale) ---
# Format "user:password". Server and all clients (worker, MacBook CLI) use the same value.
PREFECT_AUTH_STRING=admin:change-me-long-random

# --- URLs ---
# Browser-facing API URL used by the UI.
#   local dev:  http://127.0.0.1:4200/api
#   production: https://<TS_FQDN>/api   (Tailscale Serve FQDN)
PREFECT_SERVER_UI_API_URL=http://127.0.0.1:4200/api
# Browser-facing UI URL, used only for links in notifications.
#   local dev:  http://127.0.0.1:4200   production: https://<TS_FQDN>
PREFECT_UI_URL=http://127.0.0.1:4200
# Host port bound on 127.0.0.1 (change only if 4200 is taken).
PREFECT_HOST_PORT=4200

# --- Notifications (ntfy-compatible). Leave RA_NOTIFY_URL empty to only log. ---
RA_NOTIFY_URL=
RA_NOTIFY_TOPIC=
RA_NOTIFY_TOKEN=

# --- Build metadata (set by the deploy procedure: GIT_SHA=$(git rev-parse --short HEAD)) ---
GIT_SHA=dev

# ============================================================
# Phase 2: external services (Notion / Linear / OpenAI)
# Secrets go only in .env (Mac: for development / connection checks;
# lab server: for the worker). Never paste them into chat, logs or commits.
# ============================================================

# --- Notion (research task specs, read-only) ---
# Internal Integration Secret of the "Research Autopilot" integration
# (capabilities: Read content only; connected to the Research Tasks database only).
NOTION_API_TOKEN=
# Research Tasks data source ID (not secret; verified 2026-10-10).
NOTION_TASKS_DATA_SOURCE_ID=3b469893-cf8f-802d-9f86-000bb4bbb21a

# --- Linear (execution status) ---
# Personal API key (Settings > Security & access > Personal API keys).
LINEAR_API_KEY=
# Linear project "Research" UUID (not secret; verified 2026-10-10).
LINEAR_PROJECT_ID=484c0d7b-f027-4a08-b433-6e9984b50436

# --- OpenAI API (Planner / Reviewer) ---
# API key from platform.openai.com (API billing is separate from ChatGPT subscriptions).
OPENAI_API_KEY=

# --- Phase 2 planning settings (non-secret; defaults shown) ---
# Only Linear issues with this label are in scope.
RA_SCOPE_LABEL=autopilot
RA_PLANNER_MODEL=gpt-5.6-terra
RA_REVIEWER_MODEL=gpt-5.6-sol
# Linear writes (In Progress) require this AND mode=apply / --apply.
RA_LINEAR_WRITE_ENABLED=false
# Database for plan-run history on the compose PostgreSQL (create once; see phase2_planning.md).
RA_DB_NAME=research_autopilot
# USD per 1M tokens, JSON. Leave empty if unknown: costs are then reported as "not estimable".
#   {"gpt-5.6-terra": {"input_per_1m": 0.0, "output_per_1m": 0.0, "cached_input_per_1m": 0.0}}
RA_MODEL_PRICING=

# --- Phase 3 implementation (docs/operations/phase3_implementation.md) ---
RA_REPOS_FILE=config/research_repos.toml
# Worktrees live outside both repositories.
RA_WORKTREES_DIR=
# Model IDs verified on 2026-10-10 are the defaults; override only with verified IDs.
# RA_CODEX_MODEL_LIGHT=gpt-5.6-luna
# RA_CODEX_MODEL_STANDARD=gpt-5.6-terra
# RA_CODEX_MODEL_HIGH=gpt-5.6-sol
# RA_CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
# RA_CLAUDE_MODEL_STANDARD=claude-sonnet-5-5
# RA_CLAUDE_MODEL_HIGH=claude-opus-5-5
RA_IMPL_MAX_REVISIONS=2
RA_IMPL_WALL_TIME_SECONDS=1800
RA_IMPL_MAX_TOKENS=3000000
RA_IMPL_MAX_COST_USD=5
RA_CLAUDE_MAX_BUDGET_USD=2

# --- Phase 4 experiments (docs/operations/phase4_experiments.md) ---
RA_EXP_BACKEND=local
# Management reserve (OS / Prefect / PostgreSQL / monitoring) and job caps.
# Mac-safe defaults; on Eagle raise the caps explicitly (e.g. RA_EXP_MAX_JOB_CPU=host).
RA_EXP_RESERVE_CPU=2
RA_EXP_RESERVE_MEMORY_GB=4
RA_EXP_MAX_JOB_CPU=2
RA_EXP_MAX_JOB_MEMORY_GB=4
RA_EXP_MAX_PARALLEL=2
RA_EXP_MAX_WALLTIME_MIN=120
RA_EXP_MAX_RETRIES=2
RA_EXP_MAX_ROUNDTRIPS=2
RA_ANALYST_MODEL=gpt-5.6-terra
RA_SCI_REVIEWER_MODEL=gpt-5.6-sol
# Paid LLM calls run only if RA_MODEL_PRICING has the model's price; per-run cap:
RA_EXP_MAX_LLM_COST_USD=1
RA_EXP_MAX_PROPOSALS=3

# --- Phase 5 autopilot (docs/operations/phase5_autopilot.md) ---
# Notion / Linear writes happen only with RA_AUTOPILOT_WRITE=true; with RA_AUTOPILOT_TEST_ONLY=true (default)
# only issues whose title starts with "[TEST]" are written.
RA_AUTOPILOT_WRITE=false
RA_AUTOPILOT_TEST_ONLY=true
NOTION_NOTES_DATA_SOURCE_ID=31769893-cf8f-80d7-8217-000b83f7f15f
RA_AUTOPILOT_BUDGET_USD=5
RA_AUTOPILOT_BUDGET_CPU_HOURS=4
RA_AUTOPILOT_POLL_SECONDS=300
# Approval verification: "linear" = the Linear status change by an authorized user decides (default);
# "linear+form" additionally requires the Prefect form. Linear user ids allowed to approve (comma separated):
RA_APPROVAL_MODE=linear
RA_APPROVER_LINEAR_USER_IDS=
