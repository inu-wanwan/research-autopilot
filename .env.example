# Copy to .env (git-ignored) and replace every value. chmod 600 .env
# Never commit .env or paste real values into issues, logs or notifications.

# --- PostgreSQL (compose-internal only) ---
POSTGRES_USER=prefect
# URL-safe characters only (it is embedded in the DB URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=prefect

# --- Prefect Basic Auth (defense in depth on top of Tailscale) ---
# Format "user:password". Server and all clients (worker, MacBook CLI) use the same value.
PREFECT_AUTH_STRING=admin:change-me-long-random

# --- URLs ---
# Browser-facing API URL used by the UI.
#   local dev:  http://127.0.0.1:4200/api
#   production: https://<TS_FQDN>/api   (Tailscale Serve FQDN)
PREFECT_SERVER_UI_API_URL=http://127.0.0.1:4200/api
# Browser-facing UI URL, used only for links in notifications.
#   local dev:  http://127.0.0.1:4200   production: https://<TS_FQDN>
PREFECT_UI_URL=http://127.0.0.1:4200
# Host port bound on 127.0.0.1 (change only if 4200 is taken).
PREFECT_HOST_PORT=4200

# --- Notifications (ntfy-compatible). Leave RA_NOTIFY_URL empty to only log. ---
RA_NOTIFY_URL=
RA_NOTIFY_TOPIC=
RA_NOTIFY_TOKEN=

# --- Build metadata (set by the deploy procedure: GIT_SHA=$(git rev-parse --short HEAD)) ---
GIT_SHA=dev
