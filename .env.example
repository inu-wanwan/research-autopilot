# Copy to .env (git-ignored) and replace every value. chmod 600 .env
# Never commit .env or paste real values into issues, logs or notifications.

# --- PostgreSQL (compose-internal only) ---
POSTGRES_USER=prefect
# URL-safe characters only (it is embedded in the DB URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=prefect

# --- Prefect Basic Auth (defense in depth on top of Tailscale) ---
# Format "user:password". Server and all clients (worker, MacBook CLI) use the same value.
PREFECT_AUTH_STRING=admin:change-me-long-random

# --- URLs ---
# Browser-facing API URL used by the UI.
#   local dev:  http://127.0.0.1:4200/api
#   production: https://<TS_FQDN>/api   (Tailscale Serve FQDN)
PREFECT_SERVER_UI_API_URL=http://127.0.0.1:4200/api
# Browser-facing UI URL, used only for links in notifications.
#   local dev:  http://127.0.0.1:4200   production: https://<TS_FQDN>
PREFECT_UI_URL=http://127.0.0.1:4200
# Host port bound on 127.0.0.1 (change only if 4200 is taken).
PREFECT_HOST_PORT=4200

# --- Notifications / human approval UI ---
# discord (default for Phase 5), ntfy (legacy), or logging.
RA_NOTIFICATION_BACKEND=discord
RA_DISCORD_BOT_TOKEN=
RA_DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to approve/reject/request revision.
RA_DISCORD_AUTHORIZED_USER_IDS=
RA_DISCORD_APPROVAL_CHANNEL_ID=
RA_DISCORD_RESULTS_CHANNEL_ID=
RA_DISCORD_ERRORS_CHANNEL_ID=
RA_DISCORD_LOGS_CHANNEL_ID=
# Watchdog (`research-agent autopilot watch`): report channel for new stops / stalls, plus optional tuning.
RA_DISCORD_REPORT_CHANNEL_ID=
# RA_WATCH_STALL_HOURS=6
# RA_WATCH_APPROVAL_HOURS=24
# RA_WATCH_POLL_STALE_MINUTES=180
# RA_WATCH_DISCORD_BACKLOG_MINUTES=15
# RA_WATCH_TRIAGE=true
# RA_WATCH_TRIAGE_DAILY_MAX=10
# RA_WATCH_TRIAGE_PROVIDERS=codex,claude   # subscriptions only; never the pay-as-you-go API
# Fixes requested by mentioning the bot in the report channel (authorized users only; never main, never push)
# RA_WATCH_FIX=true
# RA_WATCH_FIX_PROVIDERS=codex,claude
# RA_WATCH_FIX_TEST_COMMAND=uv run pytest -q -x -p no:cacheprovider
# RA_WATCH_FIX_REPO=.
# RA_WATCH_FIX_DIR=
# Legacy ntfy backend. Kept for compatibility; used only with RA_NOTIFICATION_BACKEND=ntfy.
RA_NOTIFY_URL=
RA_NOTIFY_TOPIC=
RA_NOTIFY_TOKEN=

# --- Build metadata (set by the deploy procedure: GIT_SHA=$(git rev-parse --short HEAD)) ---
GIT_SHA=dev

# ============================================================
# Phase 2: external services (Notion / Linear / OpenAI)
# Secrets go only in .env (Mac: for development / connection checks;
# lab server: for the worker). Never paste them into chat, logs or commits.
# ============================================================

# --- Notion (research task specs, read-only) ---
# Internal Integration Secret of the "Research Autopilot" integration
# (capabilities: Read content only; connected to the Research Tasks database only).
NOTION_API_TOKEN=
# Research Tasks data source ID (not secret; verified 2026-10-10).
NOTION_TASKS_DATA_SOURCE_ID=3b469893-cf8f-802d-9f86-000bb4bbb21a

# --- Linear (execution status) ---
# Personal API key (Settings > Security & access > Personal API keys).
LINEAR_API_KEY=
# Linear project "Research" UUID (not secret; verified 2026-10-10).
LINEAR_PROJECT_ID=484c0d7b-f027-4a08-b433-6e9984b50436

# --- OpenAI API (Planner / Reviewer) ---
# API key from platform.openai.com (API billing is separate from ChatGPT subscriptions).
OPENAI_API_KEY=

# --- Phase 2 planning settings (non-secret; defaults shown) ---
# Only Linear issues with this label are in scope.
RA_SCOPE_LABEL=autopilot
RA_PLANNER_MODEL=gpt-5.6-terra
RA_REVIEWER_MODEL=gpt-5.6-sol
# Linear writes (In Progress) require this AND mode=apply / --apply.
RA_LINEAR_WRITE_ENABLED=false
# Assignee of the Linear issues RA creates (cycle tasks, follow-ups): none (default, unassigned) or me (API key owner).
RA_LINEAR_ASSIGNEE=none
# Database for plan-run history on the compose PostgreSQL (create once; see phase2_planning.md).
RA_DB_NAME=research_autopilot
# USD per 1M tokens, JSON. Leave empty if unknown: costs are then reported as "not estimable".
#   {"gpt-5.6-terra": {"input_per_1m": 0.0, "output_per_1m": 0.0, "cached_input_per_1m": 0.0}}
RA_MODEL_PRICING=
# Structured LLM calls (planner/reviewer, analyst, scientific/completion reviewer, dependency planner, adapter
# generation, literature/research/external LLM): "codex" = try the ChatGPT/Codex subscription first via
# `codex exec` (0 USD, the CLI's own login; no API key is passed) and use the OpenAI API only on usage limit /
# auth / process error / timeout / invalid output (retried once). A usage limit skips codex for 15 min. Default off.
# Providers are tried in the written order ("claude,codex" = Claude first).
# "codex,claude" also tries the claude.ai subscription (`claude -p --json-schema`, no tools; skipped when the
# claude login is API-billed) before the API. Model: RA_LLM_SUBSCRIPTION_CLAUDE_MODEL (default claude-opus-5-5).
# RA_LLM_SUBSCRIPTION_FIRST=codex,claude
# Optional path of the codex executable for these calls (default: codex on PATH).
# RA_LLM_SUBSCRIPTION_CODEX=codex

# --- Phase 3 implementation (docs/operations/phase3_implementation.md) ---
RA_REPOS_FILE=config/research_repos.toml
# Worktrees live outside both repositories.
RA_WORKTREES_DIR=
# Model IDs verified on 2026-10-10 are the defaults; override only with verified IDs.
# RA_CODEX_MODEL_LIGHT=gpt-5.6-luna
# RA_CODEX_MODEL_STANDARD=gpt-5.6-terra
# RA_CODEX_MODEL_HIGH=gpt-5.6-sol
# RA_CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
# RA_CLAUDE_MODEL_STANDARD=claude-sonnet-5-5
# RA_CLAUDE_MODEL_HIGH=claude-opus-5-5
RA_IMPL_MAX_REVISIONS=2
RA_IMPL_WALL_TIME_SECONDS=1800
RA_IMPL_MAX_TOKENS=3000000
RA_IMPL_MAX_COST_USD=5
RA_CLAUDE_MAX_BUDGET_USD=2
# Phase 3 fallback order when the active backend hits a usage/rate limit (comma-separated, empty = none).
# codex_api = Codex CLI billed to OPENAI_API_KEY (needs a RA_MODEL_PRICING entry for the model).
# RA_IMPL_FALLBACK_BACKEND=claude,codex_api
# RA_IMPL_MAX_FALLBACKS=2
# RA_CODEX_API_MODEL_HIGH=gpt-5.6-sol

# --- Phase 4 experiments (docs/operations/phase4_experiments.md) ---
RA_EXP_BACKEND=local
# Management reserve (OS / Prefect / PostgreSQL / monitoring) and job caps.
# Mac-safe defaults; on Eagle raise the caps explicitly (e.g. RA_EXP_MAX_JOB_CPU=host).
RA_EXP_RESERVE_CPU=2
RA_EXP_RESERVE_MEMORY_GB=4
RA_EXP_MAX_JOB_CPU=2
RA_EXP_MAX_JOB_MEMORY_GB=4
RA_EXP_MAX_PARALLEL=2
RA_EXP_MAX_WALLTIME_MIN=120
# minutes a job that fits the caps waits for free memory before blocking
RA_EXP_RESOURCE_WAIT_MIN=30
RA_EXP_MAX_RETRIES=2
RA_EXP_MAX_ROUNDTRIPS=2
RA_ANALYST_MODEL=gpt-5.6-terra
RA_SCI_REVIEWER_MODEL=gpt-5.6-sol
# Paid LLM calls run only if RA_MODEL_PRICING has the model's price; per-run cap:
RA_EXP_MAX_LLM_COST_USD=1
RA_EXP_MAX_PROPOSALS=3

# --- Phase 5 autopilot (docs/operations/phase5_autopilot.md) ---
# Notion / Linear writes happen only with RA_AUTOPILOT_WRITE=true; with RA_AUTOPILOT_TEST_ONLY=true (default)
# only issues whose title starts with "[TEST]" are written.
RA_AUTOPILOT_WRITE=false
RA_AUTOPILOT_TEST_ONLY=true
NOTION_NOTES_DATA_SOURCE_ID=31769893-cf8f-80d7-8217-000b83f7f15f
RA_AUTOPILOT_BUDGET_USD=5
RA_AUTOPILOT_BUDGET_CPU_HOURS=4
# Explicit-start poll interval. A task is never started from its label alone.
RA_AUTOPILOT_POLL_SECONDS=60
# Global research-task slots shared by single-task and parent-DAG runs. Keep 1
# unless repository/worktree and compute capacity have been reviewed.
RA_AUTOPILOT_MAX_CONCURRENT_TASKS=1
# Optional; defaults to RA_REVIEWER_MODEL. The model must have a price in RA_MODEL_PRICING.
RA_DAG_INFERENCE_MODEL=

# --- Phase 7A artifact catalog -------------------------------------------
# Name of this execution environment (e.g. mac, eagle). Artifact locations are
# recorded per environment; the registry `path` is the repository root here and
# `locations = { eagle = "..." }` names it elsewhere.
RA_CATALOG_ENVIRONMENT=local
# Phase 7B adapter generation: model (default RA_REVIEWER_MODEL; must be priced in RA_MODEL_PRICING)
# and the per-generation API budget in USD.
RA_ADAPTER_GENERATOR_MODEL=
RA_ADAPTER_GENERATION_BUDGET_USD=1.0
# When a task requires artifacts of a repository without a usable adapter, generate one automatically
# (declarative only; a failed generation is not retried for the same commit within 24h).
RA_CATALOG_AUTO_GENERATE=true
# Approval verification: Discord interaction is authoritative. Legacy linear modes remain available for migration only.
RA_APPROVAL_MODE=discord
RA_APPROVER_LINEAR_USER_IDS=

# --- Phase 8 literature research -----------------------------------------
# Contact e-mail sent to Crossref / OpenAlex / Unpaywall (polite pool; required by Unpaywall).
RA_LITERATURE_CONTACT_EMAIL=
# Optional: model (default RA_REVIEWER_MODEL; must be priced), budget per investigation, number of sources.
RA_LITERATURE_MODEL=
RA_LITERATURE_BUDGET_USD=2.0
RA_LITERATURE_MAX_SOURCES=4
# Automatic downloads per research run (Connector / OA / repository); never more than 10.
RA_LITERATURE_MAX_RETRIEVALS=10
# Private cache for OA PDFs, repository snapshots, extracted text and the catalogued literature store.
# RA_LITERATURE_CACHE_DIR=~/.research-autopilot/literature
# Extra hosts allowed for literature fetching (comma separated); GitHub token is optional (rate limits).
RA_LITERATURE_EXTRA_HOSTS=
RA_GITHUB_TOKEN=
# Approved publication of finished tasks (repositories with `publish = true` in config/research_repos.toml):
# fine-grained token limited to those repositories, Contents: Read and write + Pull requests: Read and write.
# Used only after a Discord Approve, to push the task branch and open a PR. Empty = never publish.
RA_GITHUB_PUSH_TOKEN=
# Zotero Connector automation (ported PoC). The Connector saves into the collection selected in Zotero.
RA_ZOTERO_ENABLED=true
RA_ZOTERO_COLLECTION=ResearchAutopilot
# RA_ZOTERO_CONNECTOR_DIR=~/.research-autopilot/zotero/connector   # pinned, validated 5.0.217
# RA_ZOTERO_PROFILE_DIR=~/.research-autopilot/zotero/profile
# RA_ZOTERO_SYNC_DIR=            # auto-detected from ZotMoov / Zotero prefs
# RA_ZOTERO_HEADLESS=1

# --- Phase 9 external repository onboarding --------------------------------
# Needs Docker and RA_LITERATURE_CONTACT_EMAIL (shared allowlisted network client). Registration is automatic;
# running external code for research always needs a human execution grant (Discord).
RA_EXTERNAL_ENABLED=true
# Private store for fetched sources, wheels, patched copies and the catalogued registry mirror.
# RA_EXTERNAL_DIR=~/.research-autopilot/external
# Test planner model (default RA_REVIEWER_MODEL; must be priced) and budget per onboarding.
RA_EXTERNAL_MODEL=
RA_EXTERNAL_BUDGET_USD=1.0
# Isolated verification limits (no network, no secrets, no host data during tests).
RA_EXTERNAL_SANDBOX_CPUS=2
RA_EXTERNAL_SANDBOX_MEMORY_GB=4
RA_EXTERNAL_SANDBOX_TIMEOUT_S=1200
RA_EXTERNAL_SANDBOX_DISK_GB=2
# RA_ENVIRONMENT=dev only on a development machine: enables `research-agent research approve` (CLI approval,
# recorded as cli-dev:<actor>). Leave unset / production on the lab server: approvals then come only from Discord.
# RA_ENVIRONMENT=dev

# --- Eagle host processes (docs/operations/eagle_wsl_setup.md) -------------
# Only in the `ra` user's /opt/research-autopilot/.env: the worker, Discord bot and watchdog run on the WSL host and
# reach the compose services through 127.0.0.1 (infra/compose.host.yaml publishes PostgreSQL there).
# PREFECT_API_URL=http://127.0.0.1:4200/api
# PREFECT_API_AUTH_STRING=            # the same value as PREFECT_AUTH_STRING
# RA_DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/research_autopilot
# RA_STATE_DIR=/home/ra/.local/state/research-autopilot
# Host port for PostgreSQL in that mode (compose side; default 5432).
# RA_PG_HOST_PORT=5432
# Zotero on Eagle: the Windows Zotero app through infra/host/zotero_bridge.py. Its prefs are on Windows, so the sync
# folder is not auto-detected; give the WSL path of ZotMoov's destination (= Zotero baseAttachmentPath).
# RA_ZOTERO_SYNC_DIR=/mnt/c/Users/<windows-user>/GDriveSync/GDriveZotero
